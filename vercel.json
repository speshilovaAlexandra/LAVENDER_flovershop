{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:5173/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    },
    {
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "build": {
    "env": {
      "NODE_VERSION": "20.19.0"
    }
  }
}
  ]
}
